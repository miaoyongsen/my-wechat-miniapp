<view class="page"><view class="card"><view class="label">总资产（人民币）</view><view class="total">¥{{total}}</view><view class="hint">本地演示数据，仅保存在当前微信设备</view></view><view class="heading">资产明细</view><block wx:for="{{assets}}" wx:key="id"><view class="row"><view><view class="name">{{item.name}}</view><view class="category">{{item.category}}</view></view><view class="right"><text>¥{{item.amount}}</text><button size="mini" data-id="{{item.id}}" bindtap="removeAsset">删除</button></view></view></block><view class="form"><input placeholder="资产名称（例如黄金）" value="{{name}}" bindinput="onName"/><input placeholder="金额（人民币）" type="digit" value="{{amount}}" bindinput="onAmount"/><button type="primary" bindtap="addAsset">新增资产</button></view></view>
