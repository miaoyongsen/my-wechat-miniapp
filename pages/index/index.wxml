<view class="page">
<view class="nav"><text class="brand">家庭资产 · V1.0</text><text class="eye" bindtap="toggleHidden">{{hidden?'显示金额':'隐藏金额'}}</text></view>
<view wx:if="{{tab==='home'}}">
 <view class="hero"><view class="muted">家庭总资产（CNY）</view><view class="big">¥ {{viewTotal}}</view><view class="heroLine"><view><view class="muted">本年收益</view><view class="metric">{{viewYear}}</view></view><view><view class="muted">本年收益率</view><view class="metric">{{yearRate}}</view></view></view><view class="small">年初基准及汇率可在「设置」中维护</view></view>
 <view class="card"><view class="section"><text>资产分布</text><text class="action" bindtap="toggleGroup">按{{filter}} ▾</text></view><view wx:if="{{!groups.length}}" class="empty">暂无资产，先去添加第一笔吧</view><block wx:for="{{groups}}" wx:key="name"><view class="group"><view class="groupTop"><text>{{item.name}}</text><text>{{hidden?'••••':item.amount}} · {{item.percent}}%</text></view><view class="bar"><view class="fill" style="width:{{item.percent}}%"></view></view></view></block></view>
 <view class="card"><view class="section"><text>本地股票行情</text><text class="action" bindtap="refreshMarket">立即刷新</text></view><view class="sub">{{marketStatus}}</view><view class="sub">{{marketUpdatedAt}}</view></view><view class="card"><view class="section"><text>快捷操作</text></view><view class="quick"><button bindtap="openAdd">＋ 添加资产</button><button bindtap="snapshot">保存今日快照</button></view></view>
</view>
<view wx:if="{{tab==='assets'}}"><view class="section outer"><text>资产明细（{{assets.length}}）</text><text class="action" bindtap="toggleSort">按{{sort}}排序 ⇄</text></view><input class="search" placeholder="搜索资产名称、代码或账户" value="{{search}}" bindinput="onSearch"/><view wx:if="{{!assets.length}}" class="empty">还没有资产记录</view><block wx:for="{{assets}}" wx:key="id"><view class="asset card"><view class="assetMain"><view><view class="assetName">{{item.name}}</view><view class="sub">{{item.type}} · {{item.account}} {{item.code}}</view></view><view class="assetRight"><view>{{hidden?'••••':item.displayValue}}</view><view class="sub">{{item.currency}} · {{item.returnText}}</view></view></view><view class="assetActions"><text data-id="{{item.id}}" bindtap="openTransaction">交易</text><text data-id="{{item.id}}" bindtap="edit">编辑</text><text data-id="{{item.id}}" bindtap="remove">移除</text></view></view></block><view wx:if="{{undo}}" class="undo" bindtap="undoDelete">已移除一项资产 · 点击撤销</view><button class="primary" bindtap="openAdd">＋ 添加资产</button></view>
<view wx:if="{{tab==='stats'}}"><view class="card"><view class="section">交易记录（最近100条）</view><block wx:for="{{txList}}" wx:key="id"><view class="snapshot"><text>{{item.date}} · {{item.label}} · {{item.type}}</text><text>{{item.amountText}} {{item.currency}}</text></view></block></view><view class="card"><view class="section">资产快照</view><view class="sub">手动记录资产总额；不计算最大回撤</view><button class="primary" bindtap="snapshot">保存当前资产快照</button><view wx:if="{{!snapshots.length}}" class="empty">暂无快照</view><block wx:for="{{snapshots}}" wx:key="id"><view class="snapshot"><text>{{item.date}}</text><text>{{hidden?'••••':item.display}}</text></view></block></view></view>
<view wx:if="{{tab==='settings'}}"><view class="card"><view class="section">金融机构 / 账户</view><block wx:for="{{accounts}}" wx:key="*this"><view class="snapshot">{{item}}</view></block><input class="input" placeholder="新增机构或账户名称" value="{{newAccount}}" bindinput="onAccount"/><button bindtap="addAccount">新增账户</button></view><view class="card"><view class="section">行情更新设置</view><view class="snapshot"><text>进入小程序尝试刷新股票</text><switch checked="{{autoMarket}}" bindchange="toggleAutoMarket"/></view><button bindtap="refreshMarket" loading="{{marketBusy}}">刷新股票行情</button><view class="sub">{{marketStatus}}</view></view><view class="card"><view class="section">汇率（1 单位外币 = 人民币）</view><view class="sub">汇率暂时手动维护。请先设置真实汇率，避免资产估值偏差。</view><block wx:for="{{rates}}" wx:key="currency"><view class="snapshot"><text>{{item.currency}}</text><text>{{item.rate}}</text></view></block><picker range="{{currencies}}" bindchange="rateCurrencyChange"><view class="picker">币种：{{rateCurrency}} ▾</view></picker><input class="input" type="digit" placeholder="人民币兑换率" value="{{rateValue}}" bindinput="onRate"/><button bindtap="saveRate">保存汇率</button></view><view class="card"><view class="section">本年年初资产基准</view><view class="sub">当前：{{baselineText}} 元；年内外部净流入暂不自动追踪</view><input class="input" type="digit" placeholder="填写本年1月1日总资产" value="{{baseValue}}" bindinput="onBase"/><button bindtap="setBaseline">保存年初基准</button></view><view class="card"><view class="section">数据备份</view><view class="sub">数据仅保存在当前微信设备，请定期复制 JSON 备份。</view><button bindtap="exportData">复制 JSON 备份</button><view class="section">恢复备份</view><textarea class="input" style="height:150rpx;width:100%" placeholder="粘贴完整备份 JSON" value="{{importText}}" bindinput="importField"/><button bindtap="pasteBackup">从剪贴板读取</button><button bindtap="restoreData">确认恢复（覆盖本地数据）</button></view></view>
<view wx:if="{{formOpen}}" class="overlay"><scroll-view scroll-y class="sheet"><view class="section"><text>{{editing?'编辑资产':'添加资产'}}</text><text class="action" bindtap="cancel">关闭 ×</text></view><picker range="{{types}}" bindchange="typeChange"><view class="picker">资产类型：{{form.type}} ▾</view></picker><input class="input" placeholder="资产名称（必填）" data-field="name" value="{{form.name}}" bindinput="field"/><input class="input" placeholder="股票代码 / 资产代码（可选）" data-field="code" value="{{form.code}}" bindinput="field"/><picker range="{{accounts}}" bindchange="accountChange"><view class="picker">所属账户：{{form.account}} ▾</view></picker><picker range="{{currencies}}" bindchange="currencyChange"><view class="picker">币种：{{form.currency}} ▾</view></picker><view wx:if="{{form.type==='A股'||form.type==='港股'||form.type==='美股'||form.type==='ETF'||form.type==='实物黄金'||form.type==='积存金'||form.type==='黄金ETF'||form.type==='加密货币'}}"><input class="input" type="digit" placeholder="持有数量" data-field="quantity" value="{{form.quantity}}" bindinput="field"/><input class="input" type="digit" placeholder="平均买入成本（原币）" data-field="cost" value="{{form.cost}}" bindinput="field"/><input class="input" type="digit" placeholder="当前单价（原币）" data-field="price" value="{{form.price}}" bindinput="field"/></view><view wx:else><input class="input" type="digit" placeholder="当前余额 / 本金（原币）" data-field="balance" value="{{form.balance}}" bindinput="field"/></view><view wx:if="{{form.type==='银行定期'}}"><input class="input" placeholder="年利率（%）" data-field="rate" value="{{form.rate}}" bindinput="field"/><input class="input" placeholder="起息日 YYYY-MM-DD" data-field="start" value="{{form.start}}" bindinput="field"/><input class="input" placeholder="到期日 YYYY-MM-DD" data-field="maturity" value="{{form.maturity}}" bindinput="field"/></view><input class="input" placeholder="备注（可选）" data-field="note" value="{{form.note}}" bindinput="field"/><button class="primary" bindtap="saveAsset">保存资产</button></scroll-view></view>
<view wx:if="{{txOpen}}" class="overlay"><scroll-view scroll-y class="sheet"><view class="section"><text>记录交易</text><text class="action" bindtap="closeTransaction">关闭 ×</text></view><picker range="{{txTypes}}" bindchange="txTypeChange"><view class="picker">类型：{{txType}} ▾</view></picker><input class="input" placeholder="交易日期 YYYY-MM-DD" data-field="txDate" value="{{txDate}}" bindinput="txField"/><input class="input" type="digit" placeholder="数量（现金分红无需填写）" data-field="txQuantity" value="{{txQuantity}}" bindinput="txField"/><input class="input" type="digit" placeholder="成交单价（原币）" data-field="txPrice" value="{{txPrice}}" bindinput="txField"/><input class="input" type="digit" placeholder="现金分红到账金额（原币）" data-field="txCash" value="{{txCash}}" bindinput="txField"/><input class="input" placeholder="备注" data-field="txNote" value="{{txNote}}" bindinput="txField"/><view class="sub">买卖更新持仓与成本；现金分红仅记账，不自动修改现金账户。送股增加数量，拆分按增加股数调整单位成本。</view><button class="primary" bindtap="saveTransaction">保存交易</button></scroll-view></view><view class="tabs"><view class="{{tab==='home'?'active':''}}" data-tab="home" bindtap="switchTab">总览</view><view class="{{tab==='assets'?'active':''}}" data-tab="assets" bindtap="switchTab">资产</view><view class="{{tab==='stats'?'active':''}}" data-tab="stats" bindtap="switchTab">统计</view><view class="{{tab==='settings'?'active':''}}" data-tab="settings" bindtap="switchTab">设置</view></view>
</view>