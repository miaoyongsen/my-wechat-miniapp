<view class="page">
<view class="nav"><text class="brand">家庭资产 · V1.0</text><text class="eye" bindtap="toggleHidden">{{hidden?'显示金额':'隐藏金额'}}</text></view>
<view wx:if="{{tab==='home'}}">
 <view class="hero"><view class="muted">今日收益（CNY）</view><view class="big {{dailyTrend}}">{{hidden?"••••":dailyProfit}}</view><view class="dailyRate {{dailyTrend}}">{{hidden?"••••":dailyRate}}</view><view class="small">{{dailyNote}}</view><view class="heroLine"><view><view class="muted">本年收益</view><view class="metric">{{viewYear}}</view></view><view><view class="muted">本年收益率</view><view class="metric">{{yearRate}}</view></view></view><view class="small">年度收益 = 当前总资产 − 年初资产 − 年内净存入（非时间加权收益率）</view></view>
 <view class="card"><view class="section"><text>年度统计</text></view><view class="snapshot"><text>年内外部净存入</text><text>{{hidden?"••••":yearFlows}}</text></view><view class="snapshot"><text>年内已记录现金分红</text><text>{{hidden?"••••":dividendTotal}}</text></view><view wx:if="{{unpricedCount>0}}" class="sub">注意：{{unpricedCount}} 项外币资产缺少有效汇率，人民币估值不完整</view></view><view class="card"><view class="section"><text>资产分布</text><text class="action" bindtap="toggleGroup">按{{filter}} ▾</text></view><view wx:if="{{!groups.length}}" class="empty">暂无资产，先去添加第一笔吧</view><block wx:for="{{groups}}" wx:key="name"><view class="group"><view class="groupTop"><text>{{item.name}}</text><text>{{hidden?'••••':item.amount}} · {{item.percent}}%</text></view><view class="bar"><view class="fill" style="width:{{item.percent}}%"></view></view></view></block></view>
 <view class="card"><view class="section"><text>本地股票行情</text><text class="action" bindtap="refreshMarket">立即刷新</text></view><view class="sub">{{marketStatus}}</view><view class="sub">{{marketUpdatedAt}}</view></view><view class="card totalBottom"><view class="muted">家庭总资产（CNY）</view><view class="totalAmount">¥ {{viewTotal}}</view></view>
</view>
<view wx:if="{{tab==='assets'}}"><view class="section outer"><text>资产明细（{{assets.length}}）</text><text class="action" bindtap="toggleSort">按{{sort}}排序 ⇄</text></view><input class="search" placeholder="搜索资产名称、代码或账户" value="{{search}}" bindinput="onSearch"/><view class="quick"><picker range="{{filterTypes}}" bindchange="assetFilterChange"><view class="picker">类型：{{assetFilter}} ▾</view></picker><picker range="{{accountFilters}}" bindchange="accountFilterChange"><view class="picker">账户：{{accountFilter}} ▾</view></picker><text class="action" bindtap="clearSearch">清空搜索</text></view><view wx:if="{{!assets.length}}" class="empty">还没有资产记录</view><block wx:for="{{assets}}" wx:key="id"><view class="asset card"><view class="assetMain"><view><view class="assetName">{{item.name}}</view><view class="sub">{{item.type}} · {{item.account}} {{item.code}}</view></view><view class="assetRight"><view>{{hidden?'••••':item.displayValue}}</view><view class="sub">{{item.currency}} · {{item.returnText}}</view></view></view><view class="assetActions"><text data-id="{{item.id}}" bindtap="openTransaction">交易</text><text data-id="{{item.id}}" bindtap="edit">编辑</text><text data-id="{{item.id}}" bindtap="remove">移除</text></view></view></block><view wx:if="{{undo}}" class="undo" bindtap="undoDelete">已移除一项资产 · 点击撤销</view><button class="primary" bindtap="openAdd">＋ 添加资产</button></view>
<view wx:if="{{tab==='stats'}}"><view class="card"><view class="section">外部资金流入 / 流出</view><view class="sub">仅记录从资产统计范围外转入或转出的资金；账户之间转账不记录。此记录只修正年度收益，不会自动更改现金余额。</view><picker range="{{flowTypes}}" bindchange="flowTypeChange"><view class="picker">类型：{{flowType}} ▾</view></picker><input class="input" placeholder="金额（人民币）" type="digit" data-field="flowAmount" value="{{flowAmount}}" bindinput="flowField"/><input class="input" placeholder="日期 YYYY-MM-DD" data-field="flowDate" value="{{flowDate}}" bindinput="flowField"/><input class="input" placeholder="备注（可选）" data-field="flowNote" value="{{flowNote}}" bindinput="flowField"/><button bindtap="addFlow">{{flowEditing?"保存修改":"记录外部资金变动"}}</button><button wx:if="{{flowEditing}}" bindtap="cancelFlowEdit">取消编辑</button><block wx:for="{{flowList}}" wx:key="id"><view class="snapshot"><text>{{item.date}} · {{item.type}} · {{item.display}}</text><text class="action" data-id="{{item.id}}" bindtap="editFlow">编辑</text><text class="action" data-id="{{item.id}}" bindtap="removeFlow">删除</text></view></block></view><view class="card"><view class="section">交易记录</view><input class="input" placeholder="搜索资产、备注或交易类型" value="{{txSearch}}" bindinput="txSearchChange"/><picker range="{{txFilterTypes}}" bindchange="txFilterChange"><view class="picker">类型：{{txTypeFilter}} ▾</view></picker><block wx:for="{{txList}}" wx:key="id"><view class="snapshot"><text>{{item.date}} · {{item.label}} · {{item.type}}</text><text>{{item.amountText}} {{item.currency}}</text><text class="action" data-id="{{item.id}}" bindtap="removeTransaction">撤销</text></view></block><button bindtap="moreTransactions">查看更多交易</button></view><view class="card"><view class="section">资产快照</view><view class="sub">手动记录资产总额；不计算最大回撤</view><button class="primary" bindtap="snapshot">保存当前资产快照</button><view wx:if="{{!snapshots.length}}" class="empty">暂无快照</view><block wx:for="{{snapshots}}" wx:key="id"><view class="snapshot"><text>{{item.date}}</text><text>{{hidden?'••••':item.display}}</text><text class="action" data-id="{{item.id}}" bindtap="removeSnapshot">删除</text></view></block></view></view>
<view wx:if="{{tab==='settings'}}"><view class="card"><view class="section">公共云同步 · 免密码</view><view class="sub">{{cloudStatus}}</view><view class="sub">云端版本 {{cloudRevision}} · {{cloudEnabled?'自动同步已开启':'尚未启用自动上传'}}</view><view class="sub">任何能打开小程序的人都能查看、修改或删除云端资产，请勿录入不愿公开的财务信息。</view><button bindtap="cloudDownload" loading="{{cloudBusy}}">从云端下载（覆盖本机）</button><button wx:if="{{!cloudEnabled}}" class="primary" bindtap="cloudEnable" loading="{{cloudBusy}}">首次上传旧手机资产</button><button wx:else bindtap="cloudDisable">暂停自动同步</button><button bindtap="cloudRetry" loading="{{cloudBusy}}">重试上传本机修改</button><view class="sub">首次在有原始数据的旧手机上传，其他手机再下载；操作前请先复制JSON备份。</view></view><view class="card"><view class="section">金融机构 / 账户</view><block wx:for="{{accounts}}" wx:key="*this"><view class="snapshot"><text>{{item}}</text><text class="action" data-name="{{item}}" bindtap="renameAccount">重命名</text><text class="action" data-name="{{item}}" bindtap="deleteAccount">删除</text></view></block><input class="input" placeholder="新增机构或账户名称" value="{{newAccount}}" bindinput="onAccount"/><button bindtap="addAccount">新增账户</button></view><view class="card"><view class="section">行情更新设置</view><view class="snapshot"><text>进入小程序尝试刷新股票</text><switch checked="{{autoMarket}}" bindchange="toggleAutoMarket"/></view><button bindtap="refreshMarket" loading="{{marketBusy}}">刷新股票行情</button><view class="sub">{{marketStatus}}</view></view><view class="card"><view class="section">汇率（1 单位外币 = 人民币）</view><view class="sub">汇率暂时手动维护。请先设置真实汇率，避免资产估值偏差。</view><block wx:for="{{rates}}" wx:key="currency"><view class="snapshot"><text>{{item.currency}}</text><text>{{item.rate}}</text></view></block><picker range="{{currencies}}" bindchange="rateCurrencyChange"><view class="picker">币种：{{rateCurrency}} ▾</view></picker><input class="input" type="digit" placeholder="人民币兑换率" value="{{rateValue}}" bindinput="onRate"/><button bindtap="saveRate">保存汇率</button></view><view class="card"><view class="section">本年年初资产基准</view><view class="sub">当前：{{baselineText}} 元；外部资金流入/流出可在「统计」页面手动记录</view><input class="input" type="digit" placeholder="填写本年1月1日总资产" value="{{baseValue}}" bindinput="onBase"/><button bindtap="setBaseline">保存年初基准</button></view><view class="card"><view class="section">数据备份</view><view class="sub">当前共有 {{assetCount}} 项资产、{{snapshotCount}} 条快照。更换设备前请先导出备份。</view><view class="sub">启用云同步后数据也保存在云端，仍请定期复制 JSON 备份。</view><button bindtap="exportData">复制 JSON 备份</button><view class="section">恢复备份</view><textarea class="input" style="height:150rpx;width:100%" placeholder="粘贴完整备份 JSON" value="{{importText}}" bindinput="importField"/><button bindtap="pasteBackup">从剪贴板读取</button><button bindtap="restoreData">确认恢复（覆盖本地数据）</button></view></view>
<view wx:if="{{formOpen}}" class="overlay"><scroll-view scroll-y class="sheet"><view class="section"><text>{{editing?'编辑资产':'添加资产'}}</text><text class="action" bindtap="cancel">关闭 ×</text></view><picker range="{{types}}" bindchange="typeChange"><view class="picker">资产类型：{{form.type}} ▾</view></picker><input class="input" placeholder="资产名称（必填）" data-field="name" value="{{form.name}}" bindinput="field"/><input class="input" placeholder="股票代码 / 资产代码（可选）" data-field="code" value="{{form.code}}" bindinput="field"/><picker range="{{accounts}}" bindchange="accountChange"><view class="picker">所属账户：{{form.account}} ▾</view></picker><picker range="{{currencies}}" bindchange="currencyChange"><view class="picker">币种：{{form.currency}} ▾</view></picker><view wx:if="{{form.type==='A股'||form.type==='港股'||form.type==='美股'||form.type==='ETF'||form.type==='实物黄金'||form.type==='积存金'||form.type==='黄金ETF'||form.type==='加密货币'}}"><input class="input" type="digit" placeholder="持有数量" data-field="quantity" value="{{form.quantity}}" bindinput="field"/><input class="input" type="digit" placeholder="平均买入成本（原币）" data-field="cost" value="{{form.cost}}" bindinput="field"/><input class="input" type="digit" placeholder="当前单价（原币）" data-field="price" value="{{form.price}}" bindinput="field"/></view><view wx:else><input class="input" type="digit" placeholder="当前余额 / 本金（原币）" data-field="balance" value="{{form.balance}}" bindinput="field"/></view><view wx:if="{{form.type==='银行定期'}}"><input class="input" placeholder="年利率（%）" data-field="rate" value="{{form.rate}}" bindinput="field"/><input class="input" placeholder="起息日 YYYY-MM-DD" data-field="start" value="{{form.start}}" bindinput="field"/><input class="input" placeholder="到期日 YYYY-MM-DD" data-field="maturity" value="{{form.maturity}}" bindinput="field"/></view><input class="input" placeholder="备注（可选）" data-field="note" value="{{form.note}}" bindinput="field"/><button class="primary" bindtap="saveAsset">保存资产</button></scroll-view></view>
<view wx:if="{{txOpen}}" class="overlay"><scroll-view scroll-y class="sheet"><view class="section"><text>记录交易</text><text class="action" bindtap="closeTransaction">关闭 ×</text></view><picker range="{{txTypes}}" bindchange="txTypeChange"><view class="picker">类型：{{txType}} ▾</view></picker><input class="input" placeholder="交易日期 YYYY-MM-DD" data-field="txDate" value="{{txDate}}" bindinput="txField"/><input class="input" type="digit" placeholder="数量（现金分红无需填写）" data-field="txQuantity" value="{{txQuantity}}" bindinput="txField"/><input class="input" type="digit" placeholder="成交单价（原币）" data-field="txPrice" value="{{txPrice}}" bindinput="txField"/><input class="input" type="digit" placeholder="现金分红到账金额（原币）" data-field="txCash" value="{{txCash}}" bindinput="txField"/><input class="input" placeholder="备注" data-field="txNote" value="{{txNote}}" bindinput="txField"/><view class="sub">买卖更新持仓与成本；现金分红仅记账，不自动修改现金账户。送股增加数量，拆分按增加股数调整单位成本。</view><button class="primary" bindtap="saveTransaction">保存交易</button></scroll-view></view><view class="addFab" bindtap="openAdd" aria-label="添加资产">＋</view><view class="tabs"><view class="{{tab==='home'?'active':''}}" data-tab="home" bindtap="switchTab">总览</view><view class="{{tab==='assets'?'active':''}}" data-tab="assets" bindtap="switchTab">资产</view><view class="{{tab==='stats'?'active':''}}" data-tab="stats" bindtap="switchTab">统计</view><view class="{{tab==='settings'?'active':''}}" data-tab="settings" bindtap="switchTab">设置</view></view>
</view>