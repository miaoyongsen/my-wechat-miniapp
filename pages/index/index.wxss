.page{padding:24rpx 24rpx 160rpx}.nav{display:flex;justify-content:space-between;align-items:center;padding:16rpx 6rpx 28rpx}.brand{font-size:34rpx;font-weight:700}.eye{font-size:24rpx;color:#60718d}.hero{background:#13233f;border-radius:26rpx;padding:42rpx 36rpx;color:white;margin-bottom:24rpx}.muted{font-size:25rpx;color:#aabbd4}.big{font-size:58rpx;font-weight:700;margin:24rpx 0 34rpx}.heroLine{display:flex;gap:100rpx}.metric{font-size:33rpx;font-weight:600;margin-top:12rpx}.small{font-size:21rpx;color:#8fa4c1;margin-top:32rpx}.card{background:#fff;border-radius:22rpx;padding:30rpx;margin-bottom:22rpx}.section{display:flex;justify-content:space-between;font-size:31rpx;font-weight:700;margin-bottom:24rpx}.action{font-size:25rpx;color:#2867bd;font-weight:400}.outer{padding:16rpx 6rpx}.empty{color:#98a3b5;text-align:center;padding:45rpx 0;font-size:26rpx}.group{margin:25rpx 0}.groupTop{display:flex;justify-content:space-between;font-size:26rpx;margin-bottom:12rpx}.bar{height:12rpx;border-radius:12rpx;background:#edf2f9;overflow:hidden}.fill{height:100%;background:#3977dc;border-radius:12rpx}.quick{display:flex;gap:16rpx}.quick button{flex:1;font-size:25rpx;background:#edf3fc;color:#2257a1}.asset{padding-bottom:15rpx}.assetMain{display:flex;justify-content:space-between;align-items:center}.assetName{font-size:30rpx;font-weight:600}.sub{font-size:23rpx;color:#8794a8;margin-top:10rpx;line-height:1.6}.assetRight{text-align:right;font-size:30rpx;font-weight:600}.assetActions{display:flex;justify-content:flex-end;gap:44rpx;border-top:1rpx solid #f0f2f5;margin-top:25rpx;padding-top:18rpx;color:#3977dc;font-size:25rpx}.primary{background:#2566cb!important;color:white!important;margin:22rpx 0}.search,.input{height:85rpx;background:white;padding:0 20rpx;border-radius:12rpx;margin:15rpx 0;font-size:28rpx;box-sizing:border-box}.picker{padding:26rpx 20rpx;background:#f4f7fc;border-radius:12rpx;margin:15rpx 0;font-size:28rpx}.snapshot{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #f0f2f6;font-size:27rpx}.tabs{position:fixed;bottom:0;left:0;right:0;background:white;display:flex;justify-content:space-around;padding:25rpx 0 42rpx;box-shadow:0 -6rpx 30rpx #14233c10;z-index:5}.tabs view{color:#8190a6;font-size:27rpx}.tabs .active{color:#2364c9;font-weight:700}.overlay{position:fixed;inset:0;background:#0008;z-index:10;display:flex;align-items:flex-end}.sheet{height:85vh;background:#fff;border-radius:30rpx 30rpx 0 0;padding:30rpx;box-sizing:border-box}.undo{background:#e7f1ff;padding:22rpx;text-align:center;color:#2465bd;border-radius:14rpx;margin-bottom:20rpx}
.hero .up{color:#ff5757}.hero .down{color:#22c77b}.hero .flat{color:#dce5f3}.dailyRate{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.totalBottom{background:#13233f;color:#fff;padding:38rpx 36rpx}.totalAmount{font-size:52rpx;font-weight:700;margin-top:18rpx}

