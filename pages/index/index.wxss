.page{padding:24rpx 24rpx 160rpx}.nav{display:flex;justify-content:space-between;align-items:center;padding:16rpx 6rpx 28rpx}.brand{font-size:34rpx;font-weight:700}.eye{font-size:24rpx;color:#60718d}.hero{background:#13233f;border-radius:26rpx;padding:42rpx 36rpx;color:white;margin-bottom:24rpx}.muted{font-size:25rpx;color:#aabbd4}.big{font-size:58rpx;font-weight:700;margin:24rpx 0 34rpx}.heroLine{display:flex;gap:100rpx}.metric{font-size:33rpx;font-weight:600;margin-top:12rpx}.small{font-size:21rpx;color:#8fa4c1;margin-top:32rpx}.card{background:#fff;border-radius:22rpx;padding:30rpx;margin-bottom:22rpx}.section{display:flex;justify-content:space-between;font-size:31rpx;font-weight:700;margin-bottom:24rpx}.action{font-size:25rpx;color:#2867bd;font-weight:400}.outer{padding:16rpx 6rpx}.empty{color:#98a3b5;text-align:center;padding:45rpx 0;font-size:26rpx}.group{margin:25rpx 0}.groupTop{display:flex;justify-content:space-between;font-size:26rpx;margin-bottom:12rpx}.bar{height:12rpx;border-radius:12rpx;background:#edf2f9;overflow:hidden}.fill{height:100%;background:#3977dc;border-radius:12rpx}.quick{display:flex;gap:16rpx}.quick button{flex:1;font-size:25rpx;background:#edf3fc;color:#2257a1}.asset{padding-bottom:15rpx}.assetMain{display:flex;justify-content:space-between;align-items:center}.assetName{font-size:30rpx;font-weight:600}.sub{font-size:23rpx;color:#8794a8;margin-top:10rpx;line-height:1.6}.assetRight{text-align:right;font-size:30rpx;font-weight:600}.assetActions{display:flex;justify-content:flex-end;gap:44rpx;border-top:1rpx solid #f0f2f5;margin-top:25rpx;padding-top:18rpx;color:#3977dc;font-size:25rpx}.primary{background:#2566cb!important;color:white!important;margin:22rpx 0}.search,.input{height:85rpx;background:white;padding:0 20rpx;border-radius:12rpx;margin:15rpx 0;font-size:28rpx;box-sizing:border-box}.picker{padding:26rpx 20rpx;background:#f4f7fc;border-radius:12rpx;margin:15rpx 0;font-size:28rpx}.snapshot{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #f0f2f6;font-size:27rpx}.tabs{position:fixed;bottom:0;left:0;right:0;background:white;display:flex;justify-content:space-around;padding:25rpx 0 42rpx;box-shadow:0 -6rpx 30rpx #14233c10;z-index:5}.tabs view{color:#8190a6;font-size:27rpx}.tabs .active{color:#2364c9;font-weight:700}.overlay{position:fixed;inset:0;background:#0008;z-index:10;display:flex;align-items:flex-end}.sheet{height:85vh;background:#fff;border-radius:30rpx 30rpx 0 0;padding:30rpx;box-sizing:border-box}.undo{background:#e7f1ff;padding:22rpx;text-align:center;color:#2465bd;border-radius:14rpx;margin-bottom:20rpx}
.hero .up{color:#ff5757}.hero .down{color:#22c77b}.hero .flat{color:#dce5f3}.dailyRate{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.totalBottom{background:#13233f;color:#fff;padding:38rpx 36rpx}.totalAmount{font-size:52rpx;font-weight:700;margin-top:18rpx}

.addFab{position:fixed;right:30rpx;bottom:calc(145rpx + env(safe-area-inset-bottom));width:104rpx;height:104rpx;border-radius:52rpx;background:#2566cb;color:#fff;font-size:76rpx;font-weight:300;display:flex;align-items:center;justify-content:center;box-shadow:0 10rpx 26rpx #123a7860;z-index:6;line-height:1}

.yearGain{font-size:52rpx;font-weight:700;margin:8rpx 0 12rpx}.yearGainRate{font-size:28rpx;font-weight:600}.yearGain.up,.yearGainRate.up{color:#e5484d}.yearGain.down,.yearGainRate.down{color:#149e63}.yearGain.flat,.yearGainRate.flat{color:#66758b}

/* 2026 clean dashboard */
.page{background:#f6f8fb;min-height:100vh;box-sizing:border-box;padding:24rpx 26rpx 176rpx;color:#17243a}
.nav{padding:16rpx 4rpx 36rpx}.brand{font-size:38rpx;font-weight:750;letter-spacing:1rpx}.eye{color:#718098}
.dashboard{padding-top:8rpx}
.dashHero{background:#fff;border:1rpx solid #edf0f4;border-radius:28rpx;padding:42rpx 36rpx 38rpx;margin-bottom:20rpx}
.dashEyebrow{font-size:23rpx;color:#8b97a8;letter-spacing:2rpx;font-weight:600}
.dashProfit{font-size:76rpx;font-weight:750;letter-spacing:-2rpx;margin-top:26rpx;line-height:1.2}
.dashRate{font-size:34rpx;font-weight:650;margin-top:14rpx}
.dashProfit.up,.dashRate.up{color:#dc3f4a}.dashProfit.down,.dashRate.down{color:#15966c}.dashProfit.flat,.dashRate.flat{color:#27364d}
.dashHint{font-size:22rpx;color:#9ca6b5;margin-top:34rpx;line-height:1.6}
.dashGrid{display:flex;gap:18rpx;margin-bottom:20rpx}
.dashTile{flex:1;min-width:0;background:#fff;border:1rpx solid #edf0f4;border-radius:24rpx;padding:30rpx 24rpx;box-sizing:border-box}
.dashLabel{font-size:23rpx;color:#8995a5;font-weight:550}
.dashNumber{font-size:38rpx;color:#19283d;font-weight:750;margin-top:20rpx;white-space:nowrap}
.dashFoot{font-size:21rpx;color:#a3adba;margin-top:12rpx;line-height:1.5}
.dashUsage{background:#fff;border:1rpx solid #edf0f4;border-radius:24rpx;padding:32rpx;margin-bottom:20rpx}
.dashUsageHead{display:flex;align-items:center;justify-content:space-between}
.dashUsageValue{font-size:42rpx;font-weight:750;color:#2568d8}
.dashTrack{height:14rpx;background:#edf2f8;border-radius:20rpx;overflow:hidden;margin-top:30rpx}
.dashTrackFill{height:100%;background:#3d7bea;border-radius:20rpx}
.dashRefresh{display:flex;justify-content:space-between;align-items:center;padding:30rpx 32rpx;background:#fff;border:1rpx solid #edf0f4;border-radius:24rpx}
.dashRefreshTitle{font-size:28rpx;font-weight:650}.dashRefreshArrow{font-size:40rpx;color:#286bdb}
.dashTimestamp,.dashStatus{font-size:21rpx;color:#98a4b2;padding:12rpx 10rpx 0;line-height:1.6}
.assetRow{background:#fff;border-bottom:1rpx solid #eef1f5;padding:25rpx 26rpx 18rpx;margin-bottom:0}
.assetRow:first-of-type{border-radius:22rpx 22rpx 0 0}
.assetRow .assetMain{gap:16rpx}.assetRow .assetName{font-size:29rpx}.assetRow .assetRight{font-size:29rpx}
.assetRow .assetActions{margin-top:16rpx;padding-top:14rpx;border-color:#f5f6f8;gap:32rpx}
.tabs{border-top:1rpx solid #edf0f4;box-shadow:none;padding:24rpx 0 40rpx}
.tabs .active{color:#1c5ed2}.addFab{background:#2668da;box-shadow:0 8rpx 22rpx #2b5fba35}

/* Account-grouped holdings */
.accountCard{background:#fff;border-radius:24rpx;overflow:hidden;margin-bottom:20rpx;border:1rpx solid #edf0f4}
.accountHeader{display:flex;align-items:center;justify-content:space-between;padding:30rpx 26rpx;min-height:86rpx}
.accountIdentity{display:flex;align-items:center;min-width:0;flex:1}
.accountMarker{width:10rpx;height:65rpx;border-radius:10rpx;margin-right:22rpx;flex-shrink:0}
.accountTitle{font-size:33rpx;font-weight:750;color:#1b2940}
.accountCount{font-size:23rpx;color:#9ba6b6;margin-top:8rpx}
.accountSummary{text-align:right;max-width:55%}
.accountTotal{font-size:35rpx;font-weight:750;color:#1b2940}
.accountChevron{font-size:23rpx;color:#8594a7;margin-top:10rpx}
.accountContents{border-top:1rpx solid #f0f2f6}
.accountContents .assetRow{border-radius:0;padding:28rpx 26rpx 20rpx}
.assetLeft{flex:1;min-width:0}
.accountContents .assetName{font-size:32rpx;font-weight:650}
.accountContents .assetRight{min-width:200rpx}
.assetValue{font-size:34rpx;font-weight:750;color:#202e43}
.assetReturn{font-size:33rpx;font-weight:750;margin-top:10rpx}
.assetReturn.up{color:#df4250}.assetReturn.down{color:#12976a}.assetReturn.flat{color:#8a97a8}
.assetCurrency{font-size:21rpx;color:#a0aab8;margin-top:4rpx}
.accountContents .assetActions{font-size:25rpx}

.assetInterest{font-size:24rpx;color:#d94350;font-weight:650;margin-top:8rpx}

/* Statistics dashboard */
.statsPage{padding-bottom:24rpx}
.statsCard{background:#fff;border:1rpx solid #edf0f4;border-radius:24rpx;padding:30rpx 26rpx;margin-bottom:22rpx;overflow:hidden}
.statsTitle{font-size:32rpx;font-weight:750;color:#1b2940;margin-bottom:22rpx}
.statsRanges{display:flex;gap:14rpx;margin-bottom:10rpx}
.statsRanges text{font-size:24rpx;color:#8290a4;background:#f3f6fa;border-radius:30rpx;padding:11rpx 25rpx}
.statsRanges text.selected{background:#e8f0ff;color:#2466c6;font-weight:700}
.statsCanvas{display:block;width:100%;height:368rpx}
.statsLegend{display:flex;align-items:center;gap:22rpx;font-size:21rpx;color:#8793a5;margin-top:4rpx;flex-wrap:wrap}
.legendDot{display:inline-block;width:14rpx;height:14rpx;border-radius:50%;margin-right:9rpx;vertical-align:middle}
.legendDot.red{background:#df414b}.legendDot.green{background:#15996b}
.statsHint{font-size:22rpx;color:#98a4b4;line-height:1.55;margin-top:16rpx}
.mixLayout{display:flex;align-items:center;gap:20rpx;min-height:280rpx}
.categoryCanvas{width:272rpx;height:272rpx;flex-shrink:0}
.mixLegend{flex:1;min-width:0}
.mixItem{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0;border-bottom:1rpx solid #f1f3f6;font-size:23rpx;color:#536176;gap:8rpx}
.mixName{display:flex;align-items:center;min-width:0}.mixValue{font-weight:700;color:#26354b;white-space:nowrap}
.rankRow{display:flex;justify-content:space-between;align-items:center;padding:22rpx 2rpx;border-bottom:1rpx solid #f0f2f5}
.rankName{font-size:27rpx;font-weight:600;color:#34435a}
.rankAmount{font-size:30rpx;font-weight:750;font-variant-numeric:tabular-nums}
.rankAmount.up{color:#df414b}.rankAmount.down{color:#15996b}.rankAmount.flat{color:#8793a5}

.dashYear{background:#fff;border:1rpx solid #edf0f4;border-radius:24rpx;padding:28rpx 30rpx;margin-bottom:20rpx}
.dashYearAmount{font-size:42rpx;font-weight:750;margin-top:14rpx}
.dashYearAmount.up,.accountGain.up{color:#df414b}.dashYearAmount.down,.accountGain.down{color:#15996b}.dashYearAmount.flat,.accountGain.flat{color:#78869a}
.dashYearMeta{font-size:22rpx;color:#738198;margin-top:10rpx}
.accountFinance{display:flex;gap:16rpx;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #f0f2f6}
.accountFinance>view{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx}
.accountFinance>view>text:first-child{font-size:20rpx;color:#929eae}
.accountFinance>view>text:last-child{font-size:23rpx;font-weight:700;color:#34435a;white-space:nowrap}
.accountFinance .accountGain.up{color:#df414b}.accountFinance .accountGain.down{color:#15996b}
.baseAccountInput{width:230rpx;text-align:right;font-size:25rpx;height:66rpx}
